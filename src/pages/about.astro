---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import StatsBar from '../components/StatsBar.astro';
import { getCollection } from 'astro:content';
import { site } from '../lib/site';

const team = (await getCollection('team')).sort((a, b) => a.data.order - b.data.order);

const accentClass: Record<string, string> = {
  navy: '',
  blue: 'team-card__photo--blue',
  accent: 'team-card__photo--accent',
  mid: 'team-card__photo--mid',
};
---

<BaseLayout
  title={`About Us | ${site.name}`}
  description={`Learn about ${site.name}, our vision, mission, core values, and the team delivering sustainable land and housing across Nigeria.`}
  navSolid
  activeNav="about"
>
  <PageHero
    title="Built on Purpose, Driven by People"
    description="Redefining modern urban living through sustainable infrastructure, value-driven properties, and architectural excellence."
  />

  <section class="section" id="founding-story">
    <div class="container">
      <div class="about-snippet__grid">
        <div class="reveal">
          <h2 class="about-snippet__heading">Redefining Modern Urban Living Across Strategic Growth Corridors</h2>
          <div class="divider"></div>
          <p class="body-lg text-muted about-snippet__p">
            {site.name} is a real estate company dedicated to delivering exceptional real estate assets and sustainable land and
            housing opportunities across strategic growth corridors and partnerships in Nigeria.
          </p>
          <p class="text-muted about-snippet__p">
            We combine disciplined project delivery, verified documentation, and architectural excellence to create lasting value for
            homeowners, investors, and communities.
          </p>
          <p class="text-muted">
            With our Head Office in Abuja and Branch Office in Port Harcourt, we serve clients across Nigeria and the diaspora with
            professionalism, transparency, and investor alignment.
          </p>
        </div>
        <div class="about-snippet__img reveal reveal-delay-2">
          <img src="/images/mtv2.jpg" alt="Metavera development context" loading="lazy" width="800" height="1125" />
        </div>
      </div>
    </div>
  </section>

  <section class="section mission-vision" id="mission-vision">
    <div class="container">
      <div class="about-mv-grid">
        <div class="reveal">
          <h2 class="mission-vision__title">Our Vision: West Africa’s Most Trusted Real Estate Company</h2>
          <p class="mission-vision__text">{site.vision}</p>
        </div>
        <div class="reveal reveal-delay-2">
          <h2 class="mission-vision__title">Our Mission: Exceptional Assets Across Strategic Growth Corridors</h2>
          <p class="mission-vision__text">{site.mission}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="core-values">
    <div class="container">
      <div class="section-header text-center section-header--center reveal">
        <h2 class="section-header__title">Our Core Values</h2>
        <div class="divider divider--center"></div>
        <p class="section-header__desc section-header__desc--wide">{site.coreValuesStatement}</p>
      </div>
      <div class="values-grid values-grid--ten">
        {
          site.coreValues.map((v, i) => (
            <div class:list={['value-card', 'reveal', i % 3 ? `reveal-delay-${i % 3}` : '']}>
              <div class="value-card__num">{v.num}</div>
              <h3 class="value-card__title">{v.title}</h3>
              <p class="value-card__text">{v.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <StatsBar stats={site.aboutStats} />

  <section class="section section--white" id="team">
    <div class="container">
      <div class="section-header text-center section-header--center reveal">
        <h2 class="section-header__title">Meet Our Leadership Team</h2>
        <div class="divider divider--center"></div>
        <p class="section-header__desc">
          Experienced professionals with deep roots in Nigerian real estate, finance, and construction.
        </p>
      </div>
      <div class="team-grid">
        {
          team.map((member, i) => (
            <div class:list={['team-card', 'reveal', i ? `reveal-delay-${Math.min(i, 3)}` : '']}>
              <div class:list={['team-card__photo', accentClass[member.data.accent]]}>
                <div class="team-card__photo-text">{member.data.initials}</div>
              </div>
              <h3 class="team-card__name">{member.data.name}</h3>
              <p class="team-card__role">{member.data.role}</p>
              <p class="team-card__bio">{member.data.bio}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="about-cta" id="about-cta">
    <div class="container">
      <h2 class="about-cta__title reveal">Ready to Find Your Place with Metavera?</h2>
      <p class="about-cta__desc reveal">Browse our projects or book a free consultation with our team.</p>
      <div class="about-cta__actions reveal">
        <a href="/projects" class="btn btn--dark">Explore Projects</a>
        <a href="/contact" class="btn btn--ghost">Contact Us</a>
      </div>
    </div>
  </section>
</BaseLayout>
