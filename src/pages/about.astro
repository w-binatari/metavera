---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import StatsBar from '../components/StatsBar.astro';
import { getCollection } from 'astro:content';
import { site } from '../lib/site';

const team = (await getCollection('team')).sort((a, b) => a.data.order - b.data.order);

const values = [
  {
    num: '01',
    title: 'Integrity First',
    text: 'We say what we mean and do what we say. Every title is clean, every timeline is honest, and every contract is fair. Our reputation is more valuable than any single deal.',
  },
  {
    num: '02',
    title: 'Excellence in Craft',
    text: 'We hold ourselves and our contractors to an uncompromising standard. Good enough is never good enough at Metavera — we build to last decades, not to look good in photos.',
  },
  {
    num: '03',
    title: 'Client-Centred Always',
    text: 'Your investment is personal. We treat it that way. Every client — whether buying a ₦12M plot or a ₦250M penthouse — receives dedicated, personalised attention.',
  },
  {
    num: '04',
    title: 'Community Impact',
    text: "We don't just build buildings — we build neighbourhoods. Every Metavera project is designed to contribute positively to its surrounding community through landscaping, local hiring, and civic infrastructure.",
  },
  {
    num: '05',
    title: 'Innovation & Adaptation',
    text: 'The real estate landscape evolves — and so do we. From diaspora payment plans to smart-home integrations, we continuously evolve our offering to match the needs of modern Nigerians.',
  },
  {
    num: '06',
    title: 'Long-Term Thinking',
    text: 'We build for the next 30 years, not the next quarter. Every Metavera property is designed with appreciation and longevity in mind — for our clients and the communities they join.',
  },
];

const accentClass: Record<string, string> = {
  navy: '',
  blue: 'team-card__photo--blue',
  accent: 'team-card__photo--accent',
  mid: 'team-card__photo--mid',
};
---

<BaseLayout
  title="About Us — Metavera Ltd | Our Story, Vision & Team"
  description="Learn about Metavera Ltd — our founding story, mission, vision, core values, and the experienced team building Nigeria's real estate future."
  navSolid
  activeNav="about"
>
  <PageHero
    eyebrow="Our Story"
    title="Built on Purpose, Driven by People"
    description="Discover the people, principles, and passion behind Nigeria's most trusted real estate brand."
  />

  <section class="section" id="founding-story">
    <div class="container">
      <div class="about-snippet__grid">
        <div class="reveal">
          <p class="about-snippet__tag">Our Founding</p>
          <h2 class="about-snippet__heading">Started With a Simple Question: Why Should Quality Housing Be Rare?</h2>
          <div class="divider"></div>
          <p class="body-lg text-muted about-snippet__p">
            Metavera Ltd was founded in 2016 by a group of Nigerian property professionals who had spent years watching clients get
            shortchanged — by unclear titles, poor construction quality, and developers who disappeared after the cheque cleared.
          </p>
          <p class="text-muted about-snippet__p">
            We set out to build something different. A company anchored in radical transparency: clear documentation, honest timelines,
            and homes that look better after handover than the brochure promised.
          </p>
          <p class="text-muted">
            Today, Metavera has delivered over 38 projects across Lagos, Abuja, Enugu, Port Harcourt, and beyond — each one a statement
            that quality and affordability are not opposites.
          </p>
        </div>
        <div class="about-snippet__img reveal reveal-delay-2">
          <img src="/images/mtv2.jpg" alt="Metavera development context" loading="lazy" width="800" height="1125" />
        </div>
      </div>
    </div>
  </section>

  <section class="section mission-vision" id="mission-vision">
    <div class="container">
      <div class="about-mv-grid">
        <div class="reveal">
          <p class="mission-vision__eyebrow">Our Mission</p>
          <h2 class="mission-vision__title">To democratise access to quality real estate for every Nigerian.</h2>
          <p class="mission-vision__text">
            We exist to break the myth that premium property is only for the ultra-wealthy — delivering verified, quality-built homes
            across a range of budgets, backed by world-class service from first contact to key collection.
          </p>
        </div>
        <div class="reveal reveal-delay-2">
          <p class="mission-vision__eyebrow">Our Vision</p>
          <h2 class="mission-vision__title">To be Nigeria's most respected real estate brand by 2030.</h2>
          <p class="mission-vision__text">
            Not the largest, not the loudest — the most respected. We will earn this through consistent delivery, transparent business
            practices, and a genuine commitment to the communities we build in.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="core-values">
    <div class="container">
      <div class="section-header text-center section-header--center reveal">
        <p class="section-header__eyebrow">What We Stand For</p>
        <h2 class="section-header__title">Our Core Values</h2>
        <div class="divider divider--center"></div>
      </div>
      <div class="values-grid">
        {
          values.map((v, i) => (
            <div class:list={['value-card', 'reveal', i % 3 ? `reveal-delay-${i % 3}` : '']}>
              <div class="value-card__num">{v.num}</div>
              <h3 class="value-card__title">{v.title}</h3>
              <p class="value-card__text">{v.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <StatsBar stats={site.aboutStats} />

  <section class="section section--white" id="team">
    <div class="container">
      <div class="section-header text-center section-header--center reveal">
        <p class="section-header__eyebrow">The People Behind Metavera</p>
        <h2 class="section-header__title">Meet Our Leadership Team</h2>
        <div class="divider divider--center"></div>
        <p class="section-header__desc">
          Experienced professionals with deep roots in Nigerian real estate, finance, and construction.
        </p>
      </div>
      <div class="team-grid">
        {
          team.map((member, i) => (
            <div class:list={['team-card', 'reveal', i ? `reveal-delay-${Math.min(i, 3)}` : '']}>
              <div class:list={['team-card__photo', accentClass[member.data.accent]]}>
                <div class="team-card__photo-text">{member.data.initials}</div>
              </div>
              <h3 class="team-card__name">{member.data.name}</h3>
              <p class="team-card__role">{member.data.role}</p>
              <p class="team-card__bio">{member.data.bio}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="about-cta" id="about-cta">
    <div class="container">
      <h2 class="about-cta__title reveal">Ready to Find Your Place with Metavera?</h2>
      <p class="about-cta__desc reveal">Browse our projects or book a free consultation — no pressure, just clarity.</p>
      <div class="about-cta__actions reveal">
        <a href="/projects" class="btn btn--dark">Explore Projects</a>
        <a href="/contact" class="btn btn--ghost">Contact Us</a>
      </div>
    </div>
  </section>
</BaseLayout>
