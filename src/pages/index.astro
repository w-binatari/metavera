---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import StatsBar from '../components/StatsBar.astro';
import { getCollection } from 'astro:content';
import { site } from '../lib/site';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const featured = projects.filter((p) => p.data.featured).slice(0, 3);
const testimonials = (await getCollection('testimonials')).sort((a, b) => a.data.order - b.data.order);
const formEndpoint = site.formEndpoint || '#';
---

<BaseLayout
  title={`${site.name} — ${site.tagline}`}
  activeNav="home"
  preloadImage="/images/metavera_hero-1280.webp"
  preloadImageType="image/webp"
  ogImage="/images/metavera_hero-1280.jpg"
>
  <section class="hero" id="hero">
    <div class="hero__bg">
      <picture>
        <source
          type="image/avif"
          srcset="/images/metavera_hero-800.avif 800w, /images/metavera_hero-1280.avif 1280w, /images/metavera_hero-1920.avif 1920w"
          sizes="100vw"
        />
        <source
          type="image/webp"
          srcset="/images/metavera_hero-800.webp 800w, /images/metavera_hero-1280.webp 1280w, /images/metavera_hero-1920.webp 1920w"
          sizes="100vw"
        />
        <img
          src="/images/metavera_hero-1280.jpg"
          srcset="/images/metavera_hero-800.jpg 800w, /images/metavera_hero-1280.jpg 1280w, /images/metavera_hero-1920.jpg 1920w"
          sizes="100vw"
          alt="Modern Nigerian real estate skyline"
          width="1280"
          height="853"
          fetchpriority="high"
          decoding="async"
          loading="eager"
        />
      </picture>
    </div>
    <div class="hero__overlay"></div>
    <div class="hero__content">
      <p class="hero__eyebrow">Premium Real Estate · Nigeria</p>
      <h1 class="hero__headline">Your Dream Property, <em>Delivered.</em></h1>
      <p class="hero__sub">
        Metavera Ltd crafts residential and commercial spaces that stand the test of time — across Lagos, Abuja, and beyond.
      </p>
      <div class="hero__ctas">
        <a href="/projects" class="btn btn--primary">Explore Properties</a>
        <a href="/contact" class="btn btn--outline">Book an Inspection</a>
      </div>
    </div>
  </section>

  <StatsBar stats={site.stats} animate />

  <section class="section" id="featured-projects">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-header__eyebrow">Our Portfolio</p>
        <h2 class="section-header__title">Featured Projects</h2>
        <div class="divider"></div>
        <p class="section-header__desc">
          From elegant apartments to gated estates — every Metavera project is a statement of quality and intention.
        </p>
      </div>
      <div class="projects-grid">
        {
          featured.map((project, i) => (
            <ProjectCard
              id={project.id}
              title={project.data.title}
              location={project.data.location}
              price={project.data.price}
              image={project.data.image}
              status={project.data.status}
              statusLabel={project.data.statusLabel}
              type={project.data.type}
              delay={i}
            />
          ))
        }
      </div>
      <div class="section-cta reveal">
        <a href="/projects" class="btn btn--dark">View All Projects</a>
      </div>
    </div>
  </section>

  <section class="section about-snippet" id="about-snippet">
    <div class="container">
      <div class="about-snippet__grid">
        <div class="reveal">
          <p class="about-snippet__tag">Who We Are</p>
          <h2 class="about-snippet__heading">Building Nigeria's Property Landscape — One Estate at a Time</h2>
          <div class="divider"></div>
          <p class="body-lg text-muted about-snippet__p">
            Metavera Ltd was founded on a single conviction: that every Nigerian deserves access to quality, trustworthy real estate.
            We combine deep local expertise with international design standards to deliver properties that exceed expectations.
          </p>
          <p class="text-muted about-snippet__p about-snippet__p--last">
            From first-time homebuyers to seasoned investors, we provide transparent, end-to-end support — from site selection to key
            handover.
          </p>
          <a href="/about" class="btn btn--dark">Learn More About Us</a>
          <div class="about-snippet__value">
            <div class="about-snippet__value-item">
              <div class="about-snippet__value-num">₦42B+</div>
              <div class="about-snippet__value-label">Portfolio Value</div>
            </div>
            <div class="about-snippet__value-item">
              <div class="about-snippet__value-num">100%</div>
              <div class="about-snippet__value-label">Title Verified</div>
            </div>
          </div>
        </div>
        <div class="about-snippet__img reveal reveal-delay-2">
          <img src="/images/mtv4.jpg" alt="Metavera property development" loading="lazy" width="800" height="640" />
        </div>
      </div>
    </div>
  </section>

  <section class="section why" id="why-choose-us">
    <div class="container">
      <div class="section-header text-center section-header--center reveal">
        <p class="section-header__eyebrow">Why Metavera</p>
        <h2 class="section-header__title">Built on Principles That Matter</h2>
        <div class="divider divider--center"></div>
      </div>
      <div class="why__grid">
        <div class="why__card reveal">
          <div class="why__icon">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          </div>
          <h3 class="why__card-title">Complete Transparency</h3>
          <p class="why__card-text">
            No hidden fees, no unclear titles. Every transaction is straightforward, documented, and fully verifiable from start to
            finish.
          </p>
        </div>
        <div class="why__card reveal reveal-delay-1">
          <div class="why__icon">
            <svg viewBox="0 0 24 24" aria-hidden="true"
              ><path
                d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"
              ></path></svg
            >
          </div>
          <h3 class="why__card-title">Premium Quality</h3>
          <p class="why__card-text">
            We partner with certified engineers and architects to ensure our buildings meet the highest structural and finishing
            standards in the industry.
          </p>
        </div>
        <div class="why__card reveal reveal-delay-2">
          <div class="why__icon">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
          </div>
          <h3 class="why__card-title">Secure Investment</h3>
          <p class="why__card-text">
            All Metavera properties come with clear statutory titles — C of O, Governor's Consent, FCTDA Approval — protecting your
            investment completely.
          </p>
        </div>
        <div class="why__card reveal reveal-delay-3">
          <div class="why__icon">
            <svg viewBox="0 0 24 24" aria-hidden="true"
              ><path
                d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"
              ></path></svg
            >
          </div>
          <h3 class="why__card-title">Dedicated Support</h3>
          <p class="why__card-text">
            From your first inquiry to after key handover — our team provides responsive, personalised guidance every step of the way.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section inspection" id="book-inspection">
    <div class="container">
      <div class="inspection__grid">
        <div class="reveal">
          <p class="inspection__eyebrow">Take the First Step</p>
          <h2 class="inspection__title">Schedule a Free Site Inspection</h2>
          <p class="inspection__desc">
            Come see your future property with your own eyes. Our team will guide you through every unit, answer every question, and
            help you find the right fit.
          </p>
          <div class="inspection__check">
            <div class="inspection__check-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"></polyline></svg>
            </div>
            No commitment required
          </div>
          <div class="inspection__check">
            <div class="inspection__check-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"></polyline></svg>
            </div>
            Expert guide included
          </div>
          <div class="inspection__check">
            <div class="inspection__check-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"></polyline></svg>
            </div>
            Available weekdays &amp; weekends
          </div>
        </div>
        <div class="reveal reveal-delay-2">
          <form class="form" id="inspectionForm" data-lead-form data-endpoint={formEndpoint} action={formEndpoint} method="POST">
            <input type="hidden" name="formType" value="inspection" />
            <div class="form-row">
              <div class="form-group">
                <label class="form-label form-label--white" for="insp-name">Full Name</label>
                <input type="text" id="insp-name" name="name" class="form-input" placeholder="e.g. Amara Okafor" required />
              </div>
              <div class="form-group">
                <label class="form-label form-label--white" for="insp-phone">Phone Number</label>
                <input type="tel" id="insp-phone" name="phone" class="form-input" placeholder="e.g. 0801 234 5678" required />
              </div>
            </div>
            <div class="form-group">
              <label class="form-label form-label--white" for="insp-email">Email Address</label>
              <input type="email" id="insp-email" name="email" class="form-input" placeholder="your@email.com" />
            </div>
            <div class="form-row">
              <div class="form-group">
                <label class="form-label form-label--white" for="insp-estate">Estate of Interest</label>
                <select id="insp-estate" name="estate" class="form-select">
                  <option value="">Select a project...</option>
                  {projects.map((p) => <option value={p.data.title}>{p.data.title}</option>)}
                  <option value="Other / Not Sure">Other / Not Sure</option>
                </select>
              </div>
              <div class="form-group">
                <label class="form-label form-label--white" for="insp-date">Preferred Date</label>
                <input type="date" id="insp-date" name="date" class="form-input" />
              </div>
            </div>
            <button type="submit" class="btn btn--primary form-submit">Book My Inspection →</button>
          </form>
        </div>
      </div>
    </div>
  </section>

  <section class="section testimonials" id="testimonials">
    <div class="container">
      <div class="section-header text-center section-header--center reveal">
        <p class="section-header__eyebrow">Client Stories</p>
        <h2 class="section-header__title">Trusted by Nigerians, Proven by Results</h2>
        <div class="divider divider--center"></div>
      </div>
      <div class="testimonials__grid">
        {
          testimonials.map((t, i) => (
            <div class:list={['testimonial-card', 'reveal', i ? `reveal-delay-${Math.min(i, 3)}` : '']}>
              <div class="testimonial-card__stars" aria-label="5 out of 5 stars">★★★★★</div>
              <span class="testimonial-card__quote-mark" aria-hidden="true">"</span>
              <p class="testimonial-card__text">{t.data.quote}</p>
              <div class="testimonial-card__author">
                <div class="testimonial-card__avatar">{t.data.initials}</div>
                <div>
                  <div class="testimonial-card__name">{t.data.name}</div>
                  <div class="testimonial-card__role">{t.data.role}</div>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
